# Both settings are optional; these are the defaults.

# SQLite for now. Postgres later would be:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# (and add asyncpg as a dependency)
DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite3

# Requests per minute per API key (and per IP for requests with a bad/missing key).
RATE_LIMIT_PER_MINUTE=60
